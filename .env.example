# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Correo transaccional (formulario de contacto)
# Generar en https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# Almacenamiento de imagenes (Vercel Blob)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx
# Host exacto del store publico, sin protocolo ni ruta
# BLOB_ALLOWED_HOSTNAME=sykw99bi95mzbciw.public.blob.vercel-storage.com

# EmailJS (para futuro)
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-service-id
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your-template-id
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-public-key

# reCAPTCHA (para futuro)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
# RECAPTCHA_SECRET=your-secret-key
